// SUMMA matrix multiplication kernel (coroutine version).
//
// At each step i in [0, P):
//   - PEs in column i broadcast their home tile of A along the row.
//   - PEs in row    i broadcast their home tile of B along the column.
//   - Each PE accumulates C_tile += Ap * Bp.
//
// The two broadcasts use disjoint colors/queues/DSRs and are launched in
// parallel via @await_parallel — this replaces the original x_done/y_done
// + @block(compute_task_id) synchronization.

param c2d_params;
param memcpy_params;

// Matrix size params
param Mt: i16;
param Kt: i16;
param Nt: i16;

const STATE: local_task_id = @claim_local_task();

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");

// Two independent instances of the collectives_2d module — one per dimension.
// They must use disjoint queues and DSRs because they run concurrently
// under @await_parallel.
const mpi_x = @import_module("../benchmark-libs/collectives_2d/pe.csl", .{
    .dim_params    = c2d_params.x,
    .queues        = [2]u16{2, 4},
    .dest_dsr_ids  = [1]u16{1},
    .src0_dsr_ids  = [1]u16{1},
    .src1_dsr_ids  = [1]u16{1},
});
const mpi_y = @import_module("../benchmark-libs/collectives_2d/pe.csl", .{
    .dim_params    = c2d_params.y,
    .queues        = [2]u16{3, 5},
    .dest_dsr_ids  = [1]u16{2},
    .src0_dsr_ids  = [1]u16{2},
    .src1_dsr_ids  = [1]u16{2},
});

const P = @get_rectangle().width;

// Home tile + accumulator on each PE; column-major layout.
var A_tile = @zeros([Mt*Kt]f32);
var B_tile = @zeros([Kt*Nt]f32);
var C_tile = @zeros([Mt*Nt]f32);

var ptr_A : [*]f32 = &A_tile;
var ptr_B : [*]f32 = &B_tile;
var ptr_C : [*]f32 = &C_tile;

// Receive buffers for tiles broadcast in from other PEs.
var A_buffer = @zeros([Mt*Kt]f32);
var B_buffer = @zeros([Kt*Nt]f32);

var px: u16;
var py: u16;

// Cycle-count timing buffers (tsc_size_words = 3 u16 words per timestamp).
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer   = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16   = @zeros([timestamp.tsc_size_words*2]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

fn f_init() void {
    @coro_runtime_init();
    sys_mod.unblock_cmd_stream();
}

fn f_enable_timer() void {
    timestamp.enable_tsc();
    sys_mod.unblock_cmd_stream();
}

fn f_tic() void {
    timestamp.get_timestamp(&tscStartBuffer);
    sys_mod.unblock_cmd_stream();
}

fn f_toc() void {
    timestamp.get_timestamp(&tscEndBuffer);
    sys_mod.unblock_cmd_stream();
}

fn f_memcpy_timestamps() void {
    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];
    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];
    sys_mod.unblock_cmd_stream();
}

fn main() void {
    @activate(STATE);
}

async task f_state() void {
    timestamp.get_timestamp(&tscStartBuffer);
    mpi_x.init();
    mpi_y.init();
    px = mpi_x.pe_id;
    py = mpi_y.pe_id;

    var step: u16 = 0;
    while (step < P) : (step += 1) {
        const Ap = if (px == step) &A_tile else &A_buffer;
        const Bp = if (py == step) &B_tile else &B_buffer;

        @await_parallel(
            mpi_x.async_broadcast(step, @ptrcast([*]u32, Ap), @bitcast(u16, Mt * Kt)),
            mpi_y.async_broadcast(step, @ptrcast([*]u32, Bp), @bitcast(u16, Kt * Nt)),
        );

        // Local fmacs-based GEMM: C_tile += Ap * Bp.
        var A_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Mt} -> A_tile[i] });
        A_dsd = @set_dsd_base_addr(A_dsd, Ap);

        for (@range(i16, Kt)) |k| {
            var C_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Mt} -> C_tile[i] });

            for (@range(i16, Nt)) |j| {
                const b = Bp.*[j*Kt + k];
                @fmacs(C_dsd, C_dsd, A_dsd, b);
                C_dsd = @increment_dsd_offset(C_dsd, Mt, f32);
            }
            A_dsd = @increment_dsd_offset(A_dsd, Mt, f32);
        }
    }

    timestamp.get_timestamp(&tscEndBuffer);
    sys_mod.unblock_cmd_stream();
}

comptime {
    @bind_local_task(f_state, STATE);

    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_B, "B");
    @export_symbol(ptr_C, "C");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(f_init);
    @export_symbol(f_enable_timer);
    @export_symbol(f_tic);
    @export_symbol(f_toc);
    @export_symbol(f_memcpy_timestamps);
    @export_symbol(main);
}
