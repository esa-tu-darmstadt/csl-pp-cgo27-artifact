
param width: i16 ;   // width of the core
param height: i16 ;  // height of the core

// Allreduce's routing color is claimed internally.
const C0: color = @claim_color();

const Params = struct {
    first_px: bool,
    last_px: bool,
    first_py: bool,
    last_py: bool,
    C_ROUTE: color,
    width: i16,
    height: i16,
};

fn get_params(px:i16, py:i16) Params {

    var first_py: bool = (0 == py);
    var last_py: bool = ((height-1) == py);

    var first_px: bool = (0 == px);
    var last_px: bool = ((width-1) == px);

    return Params {
        .first_px = first_px,
        .last_px = last_px,
        .first_py = first_py,
        .last_py = last_py,
        .C_ROUTE = C0,
        .width = width,
        .height = height
    };
}
